# Copy to .env (never commit it). Every value is optional.

# --- staff area (disabled unless set). Create with:  python scripts/make_admin_hash.py
GRAMSURAKSHA_ADMIN_PASSWORD_HASH=

# --- storage (feedback + contributions). SQLite by default.
GRAMSURAKSHA_DB_PATH=data/feedback.db
GRAMSURAKSHA_DB_PERSISTENT=0       # set 1 ONLY if the path is on a persistent disk/volume
GRAMSURAKSHA_STORAGE=sqlite        # sqlite | none  (none disables feedback/contribution forms)

# --- audio
GRAMSURAKSHA_TTS=gtts              # gtts | none   (server-side audio fallback; browser read-aloud is always available)
GRAMSURAKSHA_TTS_SLOW=1
GRAMSURAKSHA_WHISPER_MODEL=small   # faster-whisper model size for voice input
VOSK_MODEL_EN=
VOSK_MODEL_HI=

# --- advanced models (off by default; nothing is downloaded at startup)
GRAMSURAKSHA_ADV_MODEL_DIR=models/advanced/checkpoint
GRAMSURAKSHA_HF_ALLOW_DOWNLOAD=0

# --- optional link reputation (opt-in per analysis; sends link addresses to the provider)
THREAT_INTEL_PROVIDER=             # safebrowsing
THREAT_INTEL_API_KEY=
